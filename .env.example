# Variables for compose.yaml. In Dockhand they are set as stack variables;
# with plain docker compose, copy this file as .env next to compose.yaml.

# Image tag: latest (follows main), a release (1.0.0, 1.0) or a commit SHA
DRAWCAD_TAG=latest

# Port on the server
DRAWCAD_PORT=8478

# Data folder on the server (created and its owner adjusted automatically)
DRAWCAD_DATA_DIR=/mnt/user/appdata/drawcad

# User the app runs as (Unraid: 99 = nobody, 100 = users)
PUID=99
PGID=100

# Limits
DRAWCAD_MAX_UPLOAD_MB=200
DRAWCAD_MAX_RENDER_PX=12000

# Days after which an unused document is deleted from the server (0 = never)
DRAWCAD_RETENTION_DAYS=30

# Limits for uploaded files
DRAWCAD_MAX_PAGES=300
DRAWCAD_MAX_IMAGE_MPX=400

# Password (HTTP Basic, user "drawcad"). Leave it empty on the local network; set one if the app
# is reachable from outside (preferably behind a reverse proxy with HTTPS anyway).
DRAWCAD_PASSWORD=
# languages for text recognition (OCR), Tesseract codes joined with "+"
DRAWCAD_OCR_LANG=ron+eng

# Mode: private (default; each browser sees only its own documents),
# personal (a single user: all documents are visible from any browser)
# or session (like private, but documents disappear from the list when the browser closes)
DRAWCAD_MODE=private
