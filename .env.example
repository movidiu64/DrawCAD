# Variabile pentru compose.yaml. În Dockhand se pun ca variabile ale stack-ului;
# cu docker compose simplu, copiază fișierul ca .env lângă compose.yaml.

# Tag-ul imaginii: latest sau un commit anume (SHA complet) pentru a fixa versiunea
DRAWCAD_TAG=latest

# Portul de pe server
DRAWCAD_PORT=8478

# Folderul de date de pe server (se creează și i se ajustează proprietarul automat)
DRAWCAD_DATA_DIR=/mnt/user/appdata/drawcad

# Utilizatorul cu care rulează aplicația (Unraid: 99 = nobody, 100 = users)
PUID=99
PGID=100

# Limite
DRAWCAD_MAX_UPLOAD_MB=200
DRAWCAD_MAX_RENDER_PX=12000

# Zile după care un document nefolosit se șterge de pe server (0 = niciodată)
DRAWCAD_RETENTION_DAYS=30

# Limite pentru fișierele încărcate
DRAWCAD_MAX_PAGES=300
DRAWCAD_MAX_IMAGE_MPX=400

# Parolă (HTTP Basic, utilizator „drawcad”). Lasă gol în rețeaua locală; pune una dacă aplicația
# e accesibilă din afară (de preferat totuși în spatele unui reverse proxy cu HTTPS).
DRAWCAD_PASSWORD=
# limbile pentru recunoașterea textului (OCR), coduri Tesseract unite cu „+”
DRAWCAD_OCR_LANG=ron+eng

# Mod de lucru: private (implicit; fiecare browser își vede doar documentele lui),
# personal (un singur utilizator: toate documentele se văd din orice browser)
# sau session (ca private, dar documentele dispar din listă la închiderea browserului)
DRAWCAD_MODE=private
