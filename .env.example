# Variabile pentru compose.yaml. În Dockhand se pun ca variabile ale stack-ului;
# cu docker compose simplu, copiază fișierul ca .env lângă compose.yaml.

# Tag-ul imaginii: latest sau un commit anume (SHA complet) pentru a fixa versiunea
DRAWCAD_TAG=latest

# Portul de pe server
DRAWCAD_PORT=8478

# Folderul de date de pe server (se creează și i se ajustează proprietarul automat)
DRAWCAD_DATA_DIR=/mnt/user/appdata/drawcad

# Utilizatorul cu care rulează aplicația (Unraid: 99 = nobody, 100 = users)
PUID=99
PGID=100

# Limite
DRAWCAD_MAX_UPLOAD_MB=200
DRAWCAD_MAX_RENDER_PX=12000

# Zile după care un document nefolosit se șterge de pe server (0 = niciodată)
DRAWCAD_RETENTION_DAYS=30
